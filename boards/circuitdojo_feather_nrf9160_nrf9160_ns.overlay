&pinctrl {
	/* USB-C is UART0 */
	uart0_default: uart0_default {
		group1 {
			/* configure P0.06 as UART_TX and P0.5 as UART_RX */
			psels = <NRF_PSEL(UART_TX, 0, 6)>, <NRF_PSEL(UART_RX, 0, 5)>;
		};
	};
	uart0_sleep: uart0_sleep {
		group1 {
			/* configure P0.06 as UART_TX and P0.5 as UART_RX */
			psels = <NRF_PSEL(UART_TX, 0, 6)>, <NRF_PSEL(UART_RX, 0, 5)>;
		};
		/* all pins are configured in low power mode */
        low-power-enable;
	};

	/* RG-15 is UART1 */
	uart1_default: uart1_default {
		group1 {
			/* configure P0.24 as UART_TX and P0.23 as UART_RX */
			psels = <NRF_PSEL(UART_TX, 0, 24)>, <NRF_PSEL(UART_RX, 0, 23)>;
		};
	};
	uart1_sleep: uart1_sleep {
		group1 {
			/* configure P0.24 as UART_TX and P0.23 as UART_RX */
			psels = <NRF_PSEL(UART_TX, 0, 24)>, <NRF_PSEL(UART_RX, 0, 23)>;
		};
		low-power-enable;
	};
};

&adc {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

/* USB-C is UART0 */
&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = < 115200 >;
	pinctrl-0 = < &uart0_default >;
	pinctrl-1 = < &uart0_sleep >;
	pinctrl-names = "default", "sleep";
};

/* RG-15 is UART1 */
&uart1 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = < 9600 >;
	pinctrl-0 = < &uart1_default >;
	pinctrl-1 = < &uart1_sleep >;
	pinctrl-names = "default", "sleep";
};